<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:background="#FAFAFA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- כפתור חזור -->
        <TextView
            android:id="@+id/btnBackToSearch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="➔"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#154C9A"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="סיכום הזמנה"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_gravity="center"
            android:layout_marginBottom="24dp"/>

        <!-- שם החניון -->
        <TextView
            android:id="@+id/tvDynamicLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <!-- מרחק הליכה  -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_route"
                android:layout_marginEnd="8dp"/>
            <TextView
                android:id="@+id/tvDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"/>
        </LinearLayout>

        <!-- סוגי רכבים מורשים  -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_car"
                android:layout_marginEnd="8dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="מתאים לכל סוגי הרכבים (כולל 4x4)"
                android:textSize="16sp"/>
        </LinearLayout>

        <!-- שעות פעילות חניון  -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_clock"
                android:layout_marginEnd="8dp"/>
            <TextView
                android:id="@+id/tvParkingHours"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"/>
        </LinearLayout>

        <!-- תאריך ושעות מוזמנים  -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_parking"
                android:layout_marginEnd="8dp"/>
            <TextView
                android:id="@+id/tvDynamicDateAndTimes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginBottom="16dp"/>

        <!-- סטטוס תפוסה בזמן אמת (פיירבייס) -->
        <TextView
            android:id="@+id/tvRealTimeStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="טוען דיווחי נהגים..."
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="24dp"/>

        <!-- אפשרויות תשלום פנגו/אשראי -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="בחירת אמצעי תשלום:"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginBottom="8dp"/>

        <RadioGroup
            android:id="@+id/rgPaymentMethod"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">
            <RadioButton
                android:id="@+id/rbPango"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="פנגו (Pango API)"
                android:checked="true"
                android:textSize="16sp"/>
            <RadioButton
                android:id="@+id/rbCreditCard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="כרטיס אשראי"
                android:textSize="16sp"/>
        </RadioGroup>

        <!-- אישור תנאים וכפתור שריון -->
        <CheckBox
            android:id="@+id/cbTerms"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="אני מאשר/ת את תנאי השימוש"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btnReserveParking"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="אישור ושריון חניה"
            android:textSize="18sp"
            android:textStyle="bold"
            android:backgroundTint="#154C9A"
            android:textColor="#FFFFFF"/>
    </LinearLayout>
</ScrollView>