<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:layoutDirection="rtl">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btnOrderNow">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- הוספתי את המרווח העליון (paddingTop) כדי לדחוף הכל למטה -->
            <LinearLayout
                android:id="@+id/topBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="12dp"
                android:paddingTop="48dp"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/btnPersonalArea"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_profile_image"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:layout_marginEnd="8dp"/>

                <EditText
                    android:id="@+id/etSearchAddress"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="48dp"
                    android:hint="חיפוש חניון או יעד..."
                    android:background="@android:drawable/editbox_background_normal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:singleLine="true"
                    android:layout_marginEnd="8dp"/>

                <Button
                    android:id="@+id/btnFutureBooking"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="הזמן חניה\nעתידית"
                    android:textSize="12sp"
                    android:backgroundTint="#0D47A1"
                    android:textColor="@android:color/white"
                    android:layout_marginEnd="8dp"/>

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/prepark_logo" />
            </LinearLayout>

            <!-- המפה של גוגל -->
            <com.google.android.gms.maps.MapView
                android:id="@+id/mapView"
                android:layout_width="match_parent"
                android:layout_height="250dp" />

            <TextView
                android:id="@+id/tvDynamicTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:gravity="center"
                android:paddingTop="16dp"
                android:paddingBottom="8dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="שימו לב, אין להנפיק כרטיס בכניסה לחניון. פתיחת השער מתבצעת באמצעות מצלמה לזיהוי לוחית רישוי! יש לחנות בכל מקום פנוי! המחירון נקבע על ידי מפעיל החניה"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="מחירון"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="החיוב יתבצע על בסיס דקת חניה, כאשר כל חלק מדקה יחויב כדקה מלאה."
                    android:textSize="14sp"
                    android:textColor="#000000"
                    android:layout_marginBottom="16dp"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="שעה ראשונה" android:textSize="16sp" android:textColor="#000000"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="54.0 ₪" android:textStyle="bold" android:textSize="16sp" android:textColor="#000000"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="שעה שניה" android:textSize="16sp" android:textColor="#000000"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="48.0 ₪" android:textStyle="bold" android:textSize="16sp" android:textColor="#000000"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="שעה שלישית" android:textSize="16sp" android:textColor="#000000"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="48.0 ₪" android:textStyle="bold" android:textSize="16sp" android:textColor="#000000"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="שעה רביעית" android:textSize="16sp" android:textColor="#000000"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2.0 ₪" android:textStyle="bold" android:textSize="16sp" android:textColor="#000000"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="שעה חמישית עד סוף השעה ה-16" android:textSize="16sp" android:textColor="#000000"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.0 ₪" android:textStyle="bold" android:textSize="16sp" android:textColor="#000000"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnOrderNow"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:text="הזמן חניה"
        android:textSize="20sp"
        android:textStyle="bold"
        android:backgroundTint="#0D47A1"
        android:textColor="@android:color/white"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>