<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="20dp"
    android:layoutDirection="rtl">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp">

        <ImageView
            android:id="@+id/btnCloseDialog"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            app:tint="#000000"
            android:background="?attr/selectableItemBackgroundBorderless"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_centerInParent="true">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_profile_image"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="האזור האישי שלי"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#000000"/>
        </LinearLayout>
    </RelativeLayout>


    <Button
        android:id="@+id/btnActivateFuture"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="הפעל שריון חניה עתידית"
        android:backgroundTint="#0D47A1"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:visibility="gone"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/btnCancelActive"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="ביטול חניה פעילה"
        android:backgroundTint="#F44336"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:visibility="gone"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/btnParkingHistory"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="היסטוריית חניות"
        android:backgroundTint="#0D47A1"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/openReportsButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="לדיווחי נהגים בזמן אמת"
        android:layout_marginTop="16dp"
        android:backgroundTint="#0D47A1"/>

    <Button
        android:id="@+id/btnCarDetails"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="פרטי רכב"
        android:backgroundTint="#0D47A1"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/btnSavedCredit"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="אמצעי תשלום"
        android:backgroundTint="#0D47A1"
        android:textColor="#FFFFFF"
        android:textSize="16sp"/>

</LinearLayout>